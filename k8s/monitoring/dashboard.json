  {
   "type": "timeseries",
   "title": "Narrative length drift: -log10(KS p-value), alert above 3 (p < 0.001)",
   "description": "One point per drift job run (every 5 min, 10-min window, <= 300 rows). p = 0.1 plots as 1; p = 1e-23 as 23.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 10,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "showPoints": "always",
      "pointSize": 6,
      "spanNulls": false,
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "-log10(drift_feature_score{feature=\"narrative_len\"})",
     "legendFormat": "narrative_len",
     "refId": "A"
    }
   ]
  },
