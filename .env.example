# Copy to .env (make setup does it). Local development defaults; never commit .env.
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops-local
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-local-secret

# Host-side clients (DVC, training, reproduction)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-local-secret
MLFLOW_TRACKING_URI=http://localhost:5050
# MLflow 3 hands out presigned URLs naming minio:9000, which the host cannot resolve; download via the server.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_DISABLE_AGENT_HINT=1
